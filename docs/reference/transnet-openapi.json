{
  "openapi": "3.1.0",
  "info": {
    "title": "Transnet service API",
    "version": "1.0.0-target",
    "description": "Target contract for the private, stateless Transnet language and canonical-knowledge service. It accepts no end-user identity or personal state and never persists request text or context. docs/interfaces/port.md is the authoritative human-readable contract."
  },
  "servers": [{"url": "http://127.0.0.1:35792", "description": "Private loopback deployment"}],
  "paths": {
    "/health": {"get": {"operationId": "health", "summary": "Report process health", "responses": {"200": {"description": "Serving", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}, "example": {"data": {"status": "ok"}, "meta": {"request_id": "req_01K4Z8P8Y7D3N5Q2F6M1J9T0VX"}}}}}}}},
    "/livez": {"get": {"operationId": "livez", "summary": "Report process liveness", "responses": {"200": {"description": "Alive", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}, "example": {"data": {"status": "ok"}, "meta": {"request_id": "req_01K4Z8Q8X2A6B7C4D9E0F3G5HJ"}}}}}}}},
    "/readyz": {"get": {"operationId": "readyz", "summary": "Report readiness", "responses": {"200": {"description": "Ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}, "example": {"data": {"status": "ok", "capabilities": {"translation": "available", "canonical_lookup": "available", "knowledge_graph": "available"}}, "meta": {"request_id": "req_01K4Z8R4CX7E2J6K1M9N3P5Q8S"}}}}}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/translate": {"post": {"operationId": "translate", "summary": "Translate bounded text", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TranslateRequest"}, "example": {"text": "That plan is still up in the air.", "source_language": "en", "target_language": "zh-CN", "preserve_formatting": true, "register": "neutral"}}}}, "responses": {"200": {"description": "Translated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}, "example": {"data": {"translation": "那个计划仍然悬而未决。", "detected_source_language": "en"}, "meta": {"request_id": "req_01K4Z8S1AK6C8D2F0G4H7J9M3N", "model_version": "translate-2026-09"}}}}}, "400": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/v1/lookups": {"post": {"operationId": "lookup", "summary": "Resolve a canonical lexical sense", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LookupRequest"}, "example": {"query": "sweltering", "source_language": "en", "explanation_language": "zh-CN", "english_dialect": "en-US", "context": "a sweltering afternoon", "detail": "full"}}}}, "responses": {"200": {"description": "Resolved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}, "example": {"data": {"query_analysis": {"normalized_form": "sweltering", "match_class": "exact_canonical"}, "matches": [{"basic_card": {"card_id": "card_sweltering_en_adj_01", "sense_id": "sense_sweltering_hot_01", "canonical_form": "sweltering", "part_of_speech": "adjective"}, "verified_relationships": [], "exploratory_associations": []}]}, "meta": {"request_id": "req_01K4Z8T5BN2P6Q9R1S3V7W0XYZ", "content_release": "knowledge-2026-09", "degraded": false}}}}}, "400": {"$ref": "#/components/responses/Error"}, "413": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "502": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/v1/senses/{sense_id}": {"get": {"operationId": "getSense", "summary": "Read a canonical sense", "parameters": [{"$ref": "#/components/parameters/SenseId"}, {"$ref": "#/components/parameters/Release"}], "responses": {"200": {"description": "Canonical sense", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}, "example": {"data": {"sense_id": "sense_sweltering_hot_01", "canonical_form": "sweltering", "language": "en", "part_of_speech": "adjective"}, "meta": {"request_id": "req_01K4Z8V2DE5F7G9H1J3K6M8NPQ", "content_release": "knowledge-2026-09"}}}}}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/v1/graph": {"get": {"operationId": "getGraph", "summary": "Read a bounded canonical graph", "parameters": [{"name": "root_kind", "in": "query", "required": true, "schema": {"enum": ["sense", "knowledge_node", "domain"]}}, {"name": "root_id", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "depth", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 2}}, {"$ref": "#/components/parameters/Release"}], "responses": {"200": {"description": "Bounded graph", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}}, "404": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}},
    "/v1/graph/nodes/{kind}/{id}/neighbors": {"get": {"operationId": "getNeighbors", "summary": "Page direct canonical neighbors", "parameters": [{"name": "kind", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "direction", "in": "query", "schema": {"enum": ["incoming", "outgoing", "both"]}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}}, {"$ref": "#/components/parameters/Release"}], "responses": {"200": {"description": "Neighbor page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Envelope"}}}}, "404": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "parameters": {
      "SenseId": {"name": "sense_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "Release": {"name": "release", "in": "query", "required": false, "schema": {"type": "string"}}
    },
    "responses": {"Error": {"description": "Safe error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Envelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {}, "meta": {"type": "object", "required": ["request_id"], "properties": {"request_id": {"type": "string"}, "content_release": {"type": "string"}}}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message", "request_id", "retryable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}, "retryable": {"type": "boolean"}}}}},
      "TranslateRequest": {"type": "object", "additionalProperties": false, "required": ["text", "source_language", "target_language"], "properties": {"text": {"type": "string", "minLength": 1}, "source_language": {"type": "string"}, "target_language": {"type": "string"}, "preserve_formatting": {"type": "boolean"}, "register": {"type": "string"}}},
      "LookupRequest": {"type": "object", "additionalProperties": false, "required": ["query"], "properties": {"query": {"type": "string", "minLength": 1, "maxLength": 100}, "source_language": {"type": "string"}, "explanation_language": {"type": "string"}, "english_dialect": {"enum": ["en-US", "en-GB"]}, "context": {"type": ["string", "null"], "maxLength": 1000}, "detail": {"enum": ["brief", "full"]}, "include": {"type": "array", "items": {"type": "string"}}}}
    }
  }
}
