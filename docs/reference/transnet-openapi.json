{
  "openapi": "3.1.0",
  "info": {
    "title": "Transnet service API",
    "version": "1.0.0-target",
    "description": "Target contract for the private, stateless Transnet translation and relationship-knowledge service. It translates connected text and builds a relationship-centered page around one resolved lexical sense or domain concept. It accepts no end-user identity or personal state and never persists request text, context, derived vectors, or intermediate analysis. docs/interfaces/port.md is the authoritative human-readable contract."
  },
  "servers": [{"url": "http://127.0.0.1:35792", "description": "Private loopback deployment"}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Report process health",
        "responses": {"200": {"description": "Serving", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthEnvelope"}}}}}
      }
    },
    "/livez": {
      "get": {
        "operationId": "livez",
        "summary": "Report process liveness",
        "responses": {"200": {"description": "Alive", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthEnvelope"}}}}}
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "summary": "Report readiness and enabled capabilities",
        "responses": {
          "200": {"description": "Ready", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadinessEnvelope"}}}},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/translate": {
      "post": {
        "operationId": "translate",
        "summary": "Translate bounded connected text",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TranslateRequest"}}}},
        "responses": {
          "200": {"description": "Translated", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TranslateEnvelope"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "422": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/lookups": {
      "post": {
        "operationId": "lookup",
        "summary": "Build a relationship-centered page for one resolved sense or concept",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LookupRequest"}}}},
        "responses": {
          "200": {"description": "Lookup, clarification, or translation routing result", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LookupEnvelope"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "422": {"$ref": "#/components/responses/Error"},
          "502": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/senses/{sense_id}": {
      "get": {
        "operationId": "getSense",
        "summary": "Read a canonical sense basic card",
        "parameters": [{"$ref": "#/components/parameters/SenseId"}, {"$ref": "#/components/parameters/ExplanationLanguage"}, {"$ref": "#/components/parameters/Release"}],
        "responses": {
          "200": {"description": "Canonical sense", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SenseEnvelope"}}}},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/graph": {
      "get": {
        "operationId": "getGraph",
        "summary": "Read a bounded, rooted canonical relationship subgraph",
        "parameters": [
          {"name": "root_kind", "in": "query", "required": true, "schema": {"enum": ["sense", "knowledge_node", "domain"]}},
          {"name": "root_id", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "depth", "in": "query", "schema": {"type": "integer", "minimum": 0, "maximum": 2}},
          {"$ref": "#/components/parameters/RelationTypes"},
          {"$ref": "#/components/parameters/VerificationState"},
          {"name": "node_limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}},
          {"name": "edge_limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200}},
          {"$ref": "#/components/parameters/Release"}
        ],
        "responses": {
          "200": {"description": "Bounded relationship graph", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GraphEnvelope"}}}},
          "404": {"$ref": "#/components/responses/Error"},
          "422": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/graph/nodes/{kind}/{id}/neighbors": {
      "get": {
        "operationId": "getNeighbors",
        "summary": "Page direct canonical relationships for one root",
        "parameters": [
          {"name": "kind", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "direction", "in": "query", "schema": {"enum": ["incoming", "outgoing", "both"]}},
          {"$ref": "#/components/parameters/RelationTypes"},
          {"$ref": "#/components/parameters/VerificationState"},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}},
          {"$ref": "#/components/parameters/Release"}
        ],
        "responses": {
          "200": {"description": "Neighbor page", "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NeighborEnvelope"}}}},
          "404": {"$ref": "#/components/responses/Error"},
          "422": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "headers": {"RequestId": {"description": "Opaque request identifier", "schema": {"type": "string"}}},
    "parameters": {
      "SenseId": {"name": "sense_id", "in": "path", "required": true, "schema": {"type": "string"}},
      "ExplanationLanguage": {"name": "explanation_language", "in": "query", "required": false, "schema": {"type": "string"}},
      "Release": {"name": "release", "in": "query", "required": false, "schema": {"type": "string"}},
      "RelationTypes": {"name": "relation_types", "in": "query", "schema": {"type": "array", "items": {"type": "string"}}},
      "VerificationState": {"name": "verification_state", "in": "query", "schema": {"enum": ["verified", "exploratory"]}}
    },
    "responses": {
      "Error": {
        "description": "Safe error that never echoes request content or internals",
        "headers": {"X-Request-Id": {"$ref": "#/components/headers/RequestId"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id"],
        "properties": {
          "request_id": {"type": "string"},
          "content_release": {"type": "string"},
          "model_version": {"type": "string"},
          "schema_version": {"type": "string"},
          "normalizer_version": {"type": "string"},
          "retrieval_version": {"type": "string"},
          "degraded": {"type": "boolean"}
        }
      },
      "HealthEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"type": "object", "required": ["status"], "properties": {"status": {"const": "ok"}}}, "meta": {"$ref": "#/components/schemas/Meta"}}},
      "ReadinessEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"type": "object", "required": ["status", "dependencies", "capabilities"], "properties": {"status": {"const": "ok"}, "dependencies": {"type": "object", "additionalProperties": {"enum": ["ready", "degraded", "unavailable"]}}, "capabilities": {"type": "object", "properties": {"translation": {"enum": ["available", "unavailable"]}, "canonical_lookup": {"enum": ["available", "degraded", "unavailable"]}, "relationship_pages": {"enum": ["available", "degraded", "unavailable"]}}}}, "meta": {"$ref": "#/components/schemas/Meta"}}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "object", "required": ["code", "message", "request_id", "retryable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}, "retryable": {"type": "boolean"}, "fields": {"type": "array", "items": {"type": "object", "required": ["field", "message"], "properties": {"field": {"type": "string"}, "message": {"type": "string"}}}}}}}},
      "LanguageTag": {"type": "string", "pattern": "^(auto|[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*)$"},
      "TranslateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_language", "target_language"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 100000},
          "source_language": {"$ref": "#/components/schemas/LanguageTag"},
          "target_language": {"$ref": "#/components/schemas/LanguageTag"},
          "dialect": {"type": "string"},
          "domain": {"type": "string"},
          "context": {"type": "string", "maxLength": 2000},
          "audience": {"type": "string"},
          "purpose": {"type": "string"},
          "register": {"type": "string"},
          "preserve_formatting": {"type": "boolean"},
          "protected_spans": {"type": "array", "items": {"type": "string"}}
        }
      },
      "TranslateEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"$ref": "#/components/schemas/TranslateResult"}, "meta": {"$ref": "#/components/schemas/Meta"}}},
      "TranslateResult": {"type": "object", "required": ["translation", "detected_source_language"], "properties": {"translation": {"type": "string"}, "detected_source_language": {"$ref": "#/components/schemas/LanguageTag"}, "tips": {"type": "array", "maxItems": 2, "items": {"type": "object", "required": ["kind", "message"], "properties": {"kind": {"type": "string"}, "message": {"type": "string"}}}, "alternative": {"type": "object", "required": ["translation", "reason"], "properties": {"translation": {"type": "string"}, "reason": {"type": "string"}}}}}},
      "LookupRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "minLength": 1, "maxLength": 100},
          "source_language": {"$ref": "#/components/schemas/LanguageTag"},
          "target_language": {"$ref": "#/components/schemas/LanguageTag"},
          "explanation_language": {"$ref": "#/components/schemas/LanguageTag"},
          "dialect": {"type": "string"},
          "domain": {"type": "string"},
          "context": {"type": "string", "maxLength": 1000},
          "audience": {"type": "string"},
          "purpose": {"type": "string"},
          "register": {"type": "string"},
          "detail": {"enum": ["brief", "full"]},
          "include": {"type": "array", "uniqueItems": true, "items": {"enum": ["meaning", "terminology", "taxonomy", "degree", "contrasts", "grammar", "collocations", "usage", "morphology", "culture", "domain", "paths"]}}
        }
      },
      "LookupEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"$ref": "#/components/schemas/LookupResult"}, "meta": {"$ref": "#/components/schemas/Meta"}}},
      "LookupResult": {
        "type": "object",
        "required": ["query_analysis", "result_mode"],
        "properties": {
          "query_analysis": {"type": "object"},
          "result_mode": {"enum": ["lookup", "clarification", "translation"]},
          "selected_root": {"$ref": "#/components/schemas/Root"},
          "domain_assessment": {"$ref": "#/components/schemas/DomainAssessment"},
          "page": {"$ref": "#/components/schemas/RelationshipPage"},
          "alternatives": {"type": "array", "items": {"$ref": "#/components/schemas/Root"}},
          "clarification": {"type": "string"},
          "translation": {"$ref": "#/components/schemas/TranslateResult"}
        }
      },
      "Root": {"type": "object", "required": ["kind", "node_id"], "properties": {"kind": {"enum": ["sense", "concept", "domain"]}, "node_id": {"type": "string"}, "sense_id": {"type": "string"}, "concept_id": {"type": "string"}}},
      "DomainAssessment": {"type": "object", "required": ["classification", "candidate_domain_ids", "reason"], "properties": {"classification": {"enum": ["general", "domain_specific", "mixed", "uncertain"]}, "candidate_domain_ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}},
      "BasicCard": {"type": "object", "required": ["card_id", "sense_id", "canonical_form", "definitions", "translations"], "properties": {"card_id": {"type": "string"}, "sense_id": {"type": "string"}, "canonical_form": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}}, "language": {"$ref": "#/components/schemas/LanguageTag"}, "part_of_speech": {"type": "string"}, "definitions": {"type": "array", "items": {"type": "string"}}, "translations": {"type": "array", "items": {}}, "pronunciations": {"type": "array", "items": {"type": "object"}}, "forms": {"type": "array", "items": {"type": "object"}}, "examples": {"type": "array", "items": {"type": "object"}}, "usage_notes": {"type": "array", "items": {"type": "string"}}, "domain_ids": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "knowledge_root_ids": {"type": "array", "items": {"type": "string"}}}},
      "RelationshipItem": {"type": "object", "required": ["relation_type", "explanation", "evidence_state"], "properties": {"edge_id": {"type": "string"}, "relation_type": {"type": "string"}, "source_node_id": {"type": "string"}, "target_node_id": {"type": "string"}, "target_label": {"type": "string"}, "explanation": {"type": "string"}, "conditions": {"type": "array", "items": {"type": "string"}}, "restrictions": {"type": "object"}, "evidence_state": {"enum": ["verified", "inferred", "exploratory"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "provenance": {"type": "array", "items": {"type": "string"}}}},
      "RelationshipSection": {"type": "object", "required": ["kind", "title", "items"], "properties": {"kind": {"enum": ["meaning", "terminology", "taxonomy", "degree", "contrasts", "grammar", "collocations", "usage", "morphology", "culture", "domain", "mechanisms", "applications", "measurements", "standards"]}, "title": {"type": "string"}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/RelationshipItem"}}}},
      "ConnectionPath": {"type": "object", "required": ["steps"], "properties": {"steps": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/components/schemas/RelationshipItem"}}}},
      "RelationshipPage": {"type": "object", "required": ["relationship_sections", "connection_paths", "exploratory_sections"], "properties": {"basic_card": {"$ref": "#/components/schemas/BasicCard"}, "concept_summary": {"type": "object"}, "relationship_sections": {"type": "array", "items": {"$ref": "#/components/schemas/RelationshipSection"}}, "connection_paths": {"type": "array", "items": {"$ref": "#/components/schemas/ConnectionPath"}}, "exploratory_sections": {"type": "array", "items": {"$ref": "#/components/schemas/RelationshipSection"}}}},
      "SenseEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"$ref": "#/components/schemas/BasicCard"}, "meta": {"$ref": "#/components/schemas/Meta"}}},
      "GraphEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"type": "object", "required": ["root", "nodes", "edges", "truncated"], "properties": {"root": {"$ref": "#/components/schemas/Root"}, "nodes": {"type": "array", "items": {"type": "object"}}, "edges": {"type": "array", "items": {"$ref": "#/components/schemas/RelationshipItem"}}, "truncated": {"type": "boolean"}}}, "meta": {"$ref": "#/components/schemas/Meta"}}},
      "NeighborEnvelope": {"type": "object", "required": ["data", "meta"], "properties": {"data": {"type": "object", "required": ["root_node_id", "neighbors"], "properties": {"root_node_id": {"type": "string"}, "neighbors": {"type": "array", "items": {"type": "object", "required": ["edge", "node"], "properties": {"edge": {"$ref": "#/components/schemas/RelationshipItem"}, "node": {"type": "object"}}}, "next_cursor": {"type": ["string", "null"]}}}, "meta": {"$ref": "#/components/schemas/Meta"}}}}
    }
  }
}
